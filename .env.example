# ─────────────────────────────────────────────────────────────
# EduGen configuration - copy this file to .env and fill it in
# ─────────────────────────────────────────────────────────────

# REQUIRED for lesson and quiz generation.
# Free key from https://console.groq.com  (no card needed)
GROQ_API_KEY=your-key-here

# Model used by the Concept Clarifier Agent.
# Any OpenAI-compatible chat model on Groq works.
EDUGEN_LLM_MODEL=llama-3.3-70b-versatile
EDUGEN_LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# Keeps you logged in across restarts. Any long random string.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
EDUGEN_SECRET_KEY=

# Embedding backend for RAG:
#   auto                   try sentence-transformers, then ollama, then hashing
#   sentence-transformers   local model, best quality, needs torch
#   ollama                  local Ollama server
#   hashing                 no dependencies, lower quality, always works
EDUGEN_EMBEDDING_BACKEND=auto
EDUGEN_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
EDUGEN_OLLAMA_MODEL=nomic-embed-text

# Show the floating agent activity console.
# Set to 0 to hide it for a production-style demo.
EDUGEN_SHOW_LOGS=1

# Flask debug reloader
EDUGEN_DEBUG=1
